# ==============================================================================
# AIOps India - Enterprise Environment Configuration Template
# Copy this file to .env or set variables in your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Engine Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890
AI_ORCHESTRATOR_MODEL=gemini-1.5-flash
AI_CONFIDENCE_THRESHOLD=0.85
AI_MAX_ORCHESTRATION_STEPS=12

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Runtime Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COMAIOPS=DEBUG

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection (Production / Docker)
# ------------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/aiops_db
DATABASE_USERNAME=aiops_user
DATABASE_PASSWORD=aiops_secure_password_2026

# Docker Compose Defaults
POSTGRES_DB=aiops_db
POSTGRES_USER=aiops_user
POSTGRES_PASSWORD=aiops_secure_password_2026

# ------------------------------------------------------------------------------
# 4. Redis Cache & Event Bus (Production / Docker)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (MinIO / AWS S3)
# ------------------------------------------------------------------------------
APP_STORAGE_S3_ENDPOINT=http://localhost:9000
APP_STORAGE_S3_BUCKET=aiops-documents
APP_STORAGE_S3_REGION=ap-south-1
APP_STORAGE_S3_ACCESS_KEY=aiops-minio-admin
APP_STORAGE_S3_SECRET_KEY=aiops-minio-secret-32chars
APP_STORAGE_S3_PRESIGNED_EXPIRATION_MINUTES=60

# Docker MinIO Root Credentials
MINIO_ROOT_USER=aiops-minio-admin
MINIO_ROOT_PASSWORD=aiops-minio-secret-32chars

# ------------------------------------------------------------------------------
# 6. JWT Authentication & Security Context
# ------------------------------------------------------------------------------
# 256-bit Base64-encoded secret key for signing tenant session tokens
JWT_SECRET=c2VjdXJlLWVudGVycHJpc2UtYWlvcHMtaW5kaWEta2V5LTIwMjYtcHJvZHVjdGlvbi1zYWFzLWNoZWNrc3Vt
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 7. Frontend Client Configuration (React / Vite / Next.js)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_SSE_STREAM_URL=http://localhost:8080/api/v1/telemetry/stream
NEXT_PUBLIC_API_URL=http://localhost:8080
