# ==============================================================================
# AIOps India - Institutional Enterprise .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Maven Artifacts
# ------------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
maven_tool/

# ------------------------------------------------------------------------------
# 2. Node, TypeScript & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
frontend/build/
frontend/out/
.next/
out/
dist/
build/
.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Variables, Secrets & Local Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Local Application Configs
application-local.yml
application-local.properties
application-secrets.yml

# Certificates & Keys
*.pem
*.key
*.crt
*.pfx
*.keystore
*.jks

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 5. Logs, Monitoring & Runtime Caches
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
*.pid
*.seed
*.pid.lock
.nyc_output/
coverage/
.turbo/
.cache/

# ------------------------------------------------------------------------------
# 6. Database, Persistence & Storage Volumes
# ------------------------------------------------------------------------------
*.h2.db
*.trace.db
*.sqlite
*.sqlite3
pgdata/
redisdata/
miniodata/

# ------------------------------------------------------------------------------
# 7. AI Agent Scratch & System Artifacts
# ------------------------------------------------------------------------------
.system_generated/
scratch/
brain/
